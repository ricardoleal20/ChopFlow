# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# Frontend (broker/ui): node_modules is installed locally, but the built
# ui/dist is committed so the broker embeds the UI and compiles from a
# fresh clone without a Node toolchain.
broker/ui/node_modules/

# TS build cache
broker/ui/tsconfig.tsbuildinfo
.DS_Store

# Runtime SQLite database files (default broker persistence target).
chopflow.db
chopflow.db-shm
chopflow.db-wal

# Tauri desktop app (app/src-tauri): build artifacts + generated schemas.
# The Rust target dir is covered by the top-level target/ rule, but Tauri's
# standalone workspace writes here; ignore it explicitly along with gen/.
app/src-tauri/target/
app/src-tauri/gen/
